{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy-policy", "permanent": true },
    { "source": "/cookies", "destination": "/cookie-policy", "permanent": true },
    { "source": "/cookies/", "destination": "/cookie-policy", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/how-to-play/", "destination": "/how-to-play", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacy-policy", "permanent": true },
    { "source": "/cookie-policy/", "destination": "/cookie-policy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/terms-of-use", "destination": "/terms", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/how-to-play.html", "destination": "/how-to-play", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/cookie-policy.html", "destination": "/cookie-policy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/how-to-play", "destination": "/how-to-play.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ]
}
